model Service {
  id                    String            @id @default(cuid())
  category              String?
  service_provider_name String?
  descriptions          String?
  schedules             Schedule[]
  certification         String?
  duration              String?
  price                 Int?
  user_id               String?
  total_slot            Int?
  service_document      ServiceDocument[]
  appointments          Appointment[]
  questions             String[]
  created_at            DateTime?         @default(now())
  endDate               DateTime?
  user                  User?             @relation(fields: [user_id], references: [id])
  reviews               Review[]          @relation("ReviewToService")

  @@map("services")
}

/// 📅 Appointment acts as both availability and booking info

model Appointment {
  id String @id @default(cuid())

  user_id String
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  service_id String
  service    Service @relation(fields: [service_id], references: [id], onDelete: Cascade)

  schedule_id String
  schedule    Schedule @relation(fields: [schedule_id], references: [id], onDelete: Cascade)

  slot_id String?
  slot    Slot?   @relation(fields: [slot_id], references: [id], onDelete: Cascade)

  paymentMethod  String @default("UNPAID")
  paymentDetails Json   @default("{}")

  personalInfo    Json     @default("{}")
  questionAnswers String[]

  status       AppointmentStatus @default(PENDING)
  subscription Subscription[]
  created_at   DateTime          @default(now())
  updated_at   DateTime          @default(now()) @updatedAt
  review       Review?           @relation("ReviewToAppointment")
  transaction  Transaction[]
  refund       Refund[]
  wallet       Wallet[]

  recordings    Recording[]
  type          String?
  coachApproval Boolean?    @default(false)

  conversations Conversation[]

  @@index([user_id])
  @@index([status])
  @@index([created_at])
  @@map("appointments")
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model Schedule {
  id          String        @id @default(cuid())
  date        DateTime?
  startTime   String?
  endTime     String?
  frequency   Frequency
  days_ofweek DaysOfWeek[]
  slots       Slot[]
  service_id  String
  service     Service       @relation(fields: [service_id], references: [id], onDelete: Cascade)
  appointment Appointment[]

  @@map("schedules")
}

enum Frequency {
  DAILY
  MONTHLY
}

enum DaysOfWeek {
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

model Slot {
  id          String        @id @default(cuid())
  date        DateTime
  start_time  String
  end_time    String
  is_booked   Boolean       @default(false)
  status      SlotStatus    @default(AVAILABLE)
  appointment Appointment[]

  schedule_id String
  schedule    Schedule @relation(fields: [schedule_id], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

enum SlotStatus {
  AVAILABLE
  PENDING
  CONFIRMED
  CANCELLED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

model ServiceDocument {
  id         String    @id @default(cuid())
  created_at DateTime  @default(now())
  updated_at DateTime  @default(now())
  deleted_at DateTime?

  status     String?
  user_id    String?
  service_id String?
  service    Service? @relation(fields: [service_id], references: [id])

  type      String?
  file_type String?
  file_path String?
  file_name String?

  @@map("service_documents")
}

model BlogDocument {
  id         String    @id @default(cuid())
  created_at DateTime  @default(now())
  updated_at DateTime  @default(now())
  deleted_at DateTime?

  status  String?
  user_id String?
  blog_id String?
  blog    Blog?   @relation(fields: [blog_id], references: [id])

  type      String?
  file_type String?
  file_path String?
  file_name String?

  @@map("blog_documents")
}

model Blog {
  id      String @id @default(cuid())
  user_id String
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  title       String
  category    String
  readingTime String
  content     String
  description String?

  blog_documents BlogDocument[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model MissedCall {
  id             String    @id @default(cuid())
  appointment_id String
  doctor_id      String
  patient_id     String
  missed_at      DateTime  @default(now())
  callback_used  Boolean   @default(false)
  callback_at    DateTime?

  @@index([appointment_id])
  @@index([doctor_id])
  @@index([patient_id])
  @@map("missed_calls")
}

model Review {
  id         String    @id @default(cuid())
  created_at DateTime  @default(now())
  updated_at DateTime  @default(now())
  deleted_at DateTime?

  // Core review data
  rating Int // 1 to 5 star rating
  review String? // Optional text review
  tags   String[] // Array of tags like "Supportive", "Expert", etc.

  // Foreign keys without bidirectional relations
  appointment_id String @unique
  reviewer_id    String
  service_id     String

  // Simple one-way relations
  appointment Appointment @relation("ReviewToAppointment", fields: [appointment_id], references: [id])
  reviewer    User        @relation("ReviewToUser", fields: [reviewer_id], references: [id])
  service     Service     @relation("ReviewToService", fields: [service_id], references: [id])

  @@index([rating])
  @@index([created_at])
  @@map("reviews")
}

model Recording {
  id             String          @id @default(uuid())
  appointment_id String
  file_url       String
  status         RecordingStatus @default(PROCESSING)
  duration       Int             @default(0)
  created_at     DateTime        @default(now())
  updated_at     DateTime        @updatedAt
  appointment    Appointment     @relation(fields: [appointment_id], references: [id])

  @@index([appointment_id])
  @@map("recordings")
}

model Wallet {
  id             String       @id @default(uuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  appointment_id String?
  appointment    Appointment? @relation(fields: [appointment_id], references: [id])
  balance        Float        @default(0)
  currency       String       @default("USD")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  type           String?
  //transactions Transaction[]
  withdrawals    Withdrawal[]
}

model Transaction {
  id          String            @id @default(uuid())
  amount      Float
  type        TransactionType
  status      TransactionStatus @default(PENDING)
  currency    String            @default("usd")
  description String?
  metadata    Json?
  //walletId    String
  //wallet      Wallet            @relation(fields: [walletId], references: [id])
  userId      String?
  user        User?             @relation(fields: [userId], references: [id])

  getuserId String?
  getuser   User?   @relation("getuser", fields: [getuserId], references: [id])

  appointment_id  String?
  appointment     Appointment? @relation(fields: [appointment_id], references: [id])
  refundId        String?
  refund          Refund?      @relation(fields: [refundId], references: [id])
  stripePaymentId String?      @unique
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model Refund {
  id             String      @id @default(uuid())
  appointment_id String
  appointment    Appointment @relation(fields: [appointment_id], references: [id])

  userId      String
  user        User         @relation(fields: [userId], references: [id])
  amount      Float
  reason      String
  status      RefundStatus @default(REQUESTED)
  adminNote   String?
  processedAt DateTime?

  stripeRefundId String?
  transaction    Transaction[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model Withdrawal {
  id       String @id @default(uuid())
  amount   Float
  walletId String
  wallet   Wallet @relation(fields: [walletId], references: [id])

  status         TransactionStatus @default(PENDING)
  stripePayoutId String?
  bankAccount    Json
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

model Subscription {
  id              String      @id @default(uuid())
  customerId      String
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  startDate       DateTime    @default(now())
  endDate         DateTime?
  appointment     Appointment @relation(fields: [appointmentId], references: [id])
  appointmentId   String
  status          String
  paymentIntentId String
  // createdAt       DateTime  @default(now())
  updatedAt       DateTime    @updatedAt
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  PAYMENT
  SUBSCRIPTION
  REFUND
  TRANSFER
  FEE
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  CONFIRMED
}

enum RecordingStatus {
  PROCESSING
  COMPLETED
}

// enum SessionStatus {
//   PENDING
//   IN_PROGRESS
//   COMPLETED
//   CANCELLED
// }

enum RefundStatus {
  REQUESTED
  APPROVED
  REJECTED
  PROCESSED
}
